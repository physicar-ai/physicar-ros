
# physicar
export PYTHONPYCACHEPREFIX=/opt/physicar/pycache
export DISPLAY=:1
export PHYSICAR_ROS_DIR=/opt/physicar/src/physicar-ros
export RMW_IMPLEMENTATION=rmw_cyclonedds_cpp
# The simulator is another container on the docker network: its ROS topics
# arrive over that network.
export CYCLONEDDS_URI=file://$PHYSICAR_ROS_DIR/deploy/sim/cyclonedds-net.xml
export ROS_AUTOMATIC_DISCOVERY_RANGE=SUBNET
source /opt/ros/lyrical/setup.bash
source ~/physicar_ws/install/setup.bash 2>/dev/null || true
eval "$(register-python-argcomplete ros2)"
eval "$(register-python-argcomplete colcon)"
