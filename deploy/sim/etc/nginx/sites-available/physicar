# PhysiCar Nginx Configuration (SIM)
#
# `/` is mode-dependent (see the include near the bottom of the server
# block): code-server on a local sim, 404 in GitHub Codespaces (VS Code
# web IS the Codespace there — no code-server installed/running).

upstream fastapi_backend {
    server 127.0.0.1:8000;
    keepalive 32;
}

upstream code_web {
    server 127.0.0.1:8080;
}

upstream novnc_backend {
    server 127.0.0.1:6080;
}

upstream myapp_backend {
    server 127.0.0.1:5000;
}

map $http_upgrade $connection_upgrade {
    default upgrade;
    ""      close;
}

server {
    # sndbuf: cap the kernel send buffer so a congested client link cannot
    # queue seconds of stale camera/lidar frames for in-order replay — the
    # webserver's latest-frame-only logic gets backpressure quickly instead.
    # (Cloudflare sits between instance and student, so this only bounds the
    # instance-side share of the backlog.) Same fix as deploy/real.
    listen 80 sndbuf=524288;
    server_name _;
    absolute_redirect off;

    client_max_body_size 500M;

    # ── Studio access-token gate ──
    # Active only for the public tunnel host (see conf.d/pc-token.conf). On the
    # public tunnel host, a valid ?token= mints a cookie and redirects to the
    # same URL without the token; missing/invalid token -> 403. All other hosts
    # (localhost, *.app.github.dev) pass through untouched.
    #
    # The Studio bookmark opens inside a VS Code webview (iframe), so the tunnel
    # is a third-party context — the cookie must be SameSite=None; Secure to be
    # sent on iframe requests. The tunnel is always https, so Secure is safe.
    if ($pc_action = "deny")  { return 403; }

    # ── Origin gate ── (see conf.d/pc-gate.conf) — block gateway-bypassing access.
    # "deny" only on cloud instances where a secret is provisioned; "pass" elsewhere.
    if ($pc_origin_gate = "deny") { return 403; }
    if ($pc_action = "grant") { set $grant_target $uri; rewrite ^ /__token_grant last; }

    location = /__token_grant {
        internal;
        add_header Set-Cookie "pc_token=$arg_token; Path=/; HttpOnly; SameSite=None; Secure" always;
        return 302 $grant_target;
    }

    # ── Simulation 3D Viewer (/sim) ──

    location = /sim {
        return 302 /sim/;
    }

    location /sim/ {
        alias /opt/physicar/src/physicar-sim/share/;
        index index.html;
        add_header Cache-Control "no-cache, must-revalidate" always;
    }

    # Heavy viewer assets (meshes/textures/models). gzweb.js stamps their
    # URLs with ?v=<world asset version>, making them safe to cache forever:
    # a world re-upload changes the version -> new URLs -> the cache is
    # bypassed instantly, and the same version means zero requests. Requests
    # WITHOUT ?v= (from any other client) stay on revalidation, so nothing
    # can ever cache stale.
    location ~ ^/sim/(meshes|models)/(.+)$ {
        alias /opt/physicar/src/physicar-sim/share/$1/$2;
        set $asset_cache "no-cache, must-revalidate";
        if ($arg_v) { set $asset_cache "public, max-age=31536000, immutable"; }
        add_header Cache-Control $asset_cache always;
    }

    # Sim API (world list, status, switch, pose, route, reset)
    location /sim/api/ {
        proxy_pass http://127.0.0.1:9003/;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header Connection "";
    }

    # ── PhysiCar extension services (tool server :9004) ──
    # Whole server, loopback-only: on-machine callers (the extension, the AI's
    # terminal, student scripts) get clean localhost URLs — /physicar-ext/tools,
    # /physicar-ext/wake, /physicar-ext/wake/status — while anything from the
    # network is denied, so the login gate cannot be bypassed.
    location /physicar-ext/ {
        allow 127.0.0.1;
        allow ::1;
        deny all;
        proxy_pass http://127.0.0.1:9004/;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header Connection "";
    }

    # Simulation WebSocket (3D scene streaming)
    location /sim/ws {
        proxy_pass http://127.0.0.1:9002;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header Upgrade $http_upgrade;
        # strip permessage-deflate offers: CF edge (h2 WS) mangles compressed
        # frames -> "Invalid frame header" in browsers; payloads are tiny anyway
        proxy_set_header Sec-WebSocket-Extensions "";
        proxy_set_header Connection "upgrade";
        proxy_read_timeout 86400s;
    }

    # ── noVNC (/vnc) ──

    location = /vnc {
        return 302 /vnc/?path=vnc/websockify&autoconnect=true&scale=true;
    }

    location ~ ^/vnc/(.+\.html)$ {
        set $vnc_page $1;
        if ($arg_path = "") {
            return 302 $uri?path=vnc/websockify&autoconnect=true&scale=true;
        }
        proxy_pass http://novnc_backend/$vnc_page$is_args$args;
        proxy_http_version 1.1;
        proxy_set_header Host $http_host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header Accept-Encoding "";
        sub_filter '</head>' '<style>#top_bar,.noVNC_button,.noVNC_panel{display:none!important}html,body,#screen{overflow:hidden!important}</style></head>';
        sub_filter_once on;
    }

    location = /vnc/ {
        if ($arg_path = "") {
            return 302 /vnc/?path=vnc/websockify&autoconnect=true&scale=true;
        }
        proxy_pass http://novnc_backend/;
        proxy_http_version 1.1;
        proxy_set_header Host $http_host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header Accept-Encoding "";
        sub_filter '</head>' '<style>#top_bar,.noVNC_button,.noVNC_panel{display:none!important}html,body,#screen{overflow:hidden!important}</style></head>';
        sub_filter_once on;
    }

    location /vnc/ {
        proxy_pass http://novnc_backend/;
        proxy_http_version 1.1;
        proxy_set_header Host $http_host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header Upgrade $http_upgrade;
        # strip permessage-deflate offers: CF edge (h2 WS) mangles compressed
        # frames -> "Invalid frame header" in browsers; payloads are tiny anyway
        proxy_set_header Sec-WebSocket-Extensions "";
        proxy_set_header Connection $connection_upgrade;
        proxy_buffering off;
        proxy_cache off;
        proxy_read_timeout 86400s;
    }

    # ── MyApp (:5000) ──

    location = /myapp { return 302 /myapp/; }

    location /myapp/ {
        proxy_pass http://myapp_backend/;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header Upgrade $http_upgrade;
        # strip permessage-deflate offers: CF edge (h2 WS) mangles compressed
        # frames -> "Invalid frame header" in browsers; payloads are tiny anyway
        proxy_set_header Sec-WebSocket-Extensions "";
        proxy_set_header Connection $connection_upgrade;

        proxy_set_header If-Modified-Since "";
        proxy_set_header If-None-Match "";

        # ── PhysiCar session helper auto-injection ──
        # Student pages need zero setup: injects window.physicarSession.token()
        # (reads the physicar_session cookie). Only HTML is rewritten
        # (sub_filter_types defaults to text/html) — SSE/MJPEG pass untouched.
        proxy_set_header Accept-Encoding "";
        sub_filter_once on;
        sub_filter '<head>' '<head><script src="/static/js/physicar-session.js"></script>';

        proxy_buffering off;
        proxy_request_buffering off;
        chunked_transfer_encoding off;
        gzip off;

        add_header Cache-Control "no-store, no-cache, must-revalidate, max-age=0" always;
        add_header Pragma "no-cache" always;
        add_header Expires "0" always;
        add_header X-Accel-Buffering "no" always;

        proxy_connect_timeout 5s;
        # No send/read limits: student apps may hold quiet WebSocket/SSE
        # connections open indefinitely (connect stays 5s for the offline page)
        proxy_send_timeout 86400s;
        proxy_read_timeout 86400s;
        error_page 502 503 504 = @myapp_offline;
    }

    location @myapp_offline {
        default_type text/html;
        charset utf-8;
        add_header Cache-Control "no-store" always;
        add_header X-MyApp-Status "offline" always;
        return 200 '<!DOCTYPE html><html><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title>MyApp</title><style>html,body{margin:0;height:100%;overflow:hidden;background:#0d0d10;color:#aaa;font-family:system-ui,sans-serif}body{display:flex;align-items:center;justify-content:center;text-align:center;font-size:4vw}h2{font-size:6.5vw}code{background:#222;padding:.4vw 1.2vw;border-radius:.8vw;color:#b388ff}.box{padding:5vw}.spin{display:inline-block;width:3.2vw;height:3.2vw;border:.45vw solid #333;border-top-color:#888;border-radius:50%;animation:s 1s linear infinite;vertical-align:middle;margin-right:1.6vw}@keyframes s{to{transform:rotate(360deg)}}</style></head><body><div class="box"><h2>MyApp is not running</h2><p>It will auto-start on port <code>5000</code>.</p><p style="color:#666"><span class="spin"></span>Auto-reloading…</p></div><script>(function(){var n=0,t=null;function arm(ms){t=setTimeout(chk,ms)}async function chk(){t=null;if(document.hidden)return;try{var r=await fetch(location.pathname+(location.pathname.endsWith("/")?"":"/")+"?_t="+Date.now(),{cache:"no-store"});if(r.headers.get("X-MyApp-Status")!=="offline"){location.reload();return}}catch(e){}n++;arm(n<15?2000:15000)}document.addEventListener("visibilitychange",function(){if(!document.hidden&&!t)chk()});arm(2000)})();</script></body></html>';
    }

    # Legacy path (pre-rename bookmarks). /app itself is served by FastAPI
    # (with cache-busted asset URLs) via the explicit-prefix location below.
    location = /studio { return 302 /app; }

    # ── Streaming drive control (WebSocket write streams) ──
    # Regex locations are order-sensitive — this must precede the FastAPI catch-all
    location ~ ^/(speed|steering)/stream$ {
        proxy_pass http://fastapi_backend;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header Upgrade $http_upgrade;
        # strip permessage-deflate offers: CF edge (h2 WS) mangles compressed
        # frames -> "Invalid frame header" in browsers; payloads are tiny anyway
        proxy_set_header Sec-WebSocket-Extensions "";
        proxy_set_header Connection $connection_upgrade;
        proxy_buffering off;
        proxy_read_timeout 86400s;
    }

    # ── Audio realtime PCM16 stream (WebSocket) ──
    location = /audio/stream {
        proxy_pass http://fastapi_backend;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header Upgrade $http_upgrade;
        # strip permessage-deflate offers: CF edge (h2 WS) mangles compressed
        # frames -> "Invalid frame header" in browsers; payloads are tiny anyway
        proxy_set_header Sec-WebSocket-Extensions "";
        proxy_set_header Connection $connection_upgrade;
        proxy_buffering off;
        proxy_read_timeout 86400s;
    }

    # ── code-server 정적 번들 직접 서빙 (무결성) ──
    # code-server 는 정적 파일을 Content-Length/ETag 없이 chunked 로 서빙한다(실측 2026-09-06).
    # 전송이 중간에 끊기면 브라우저가 잘린 파일을 완전한 것으로 오인해 max-age=1y 캐시에
    # 박제 → 웹뷰 영구 백지 사고의 원천. nginx 파일 서빙은 Content-Length·ETag·Range 를
    # 자동 부여해 잘린 다운로드를 브라우저가 스스로 폐기한다. 부팅 패치(entrypoint.sh 의
    # 번들 제자리 수정)와 같은 파일을 읽으므로 패치 내용은 그대로 반영되고, 없는 경로는
    # code-server 로 폴백해 특수/신규 경로에도 동작이 변하지 않는다.
    location ~ ^/stable-[a-f0-9]+/static/(?<cs_asset>.+)$ {
        root /usr/lib/code-server/lib/vscode;
        try_files /$cs_asset @cs_static_fb;
        add_header Cache-Control "public, max-age=31536000" always;
    }
    location @cs_static_fb {
        proxy_pass http://code_web;
        proxy_http_version 1.1;
        proxy_set_header Host $http_host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header Connection "";
    }

    # ── PhysiCar app (FastAPI :8000) — pages + APIs ──
    # `/` belongs to code-server (or 404 in Codespaces), so every FastAPI
    # route is listed here explicitly: pages (/app), assets
    # (/static /favicon.ico /docs /redoc /openapi.json)
    # and APIs. Add new top-level FastAPI prefixes to this list.
    location ~ ^/(app|racing|static|docs|redoc|openapi\.json|favicon\.ico|health|info|auth|network|calibration|teleop|settings|kiosk|states|speed|steering|camera|lidar|audio|battery|imu|odom|log|api)(/|$) {
        proxy_pass http://fastapi_backend;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header Connection "";

        proxy_buffering off;
        proxy_request_buffering off;
        proxy_cache off;
        chunked_transfer_encoding off;
        gzip off;
        add_header X-Accel-Buffering no always;

        proxy_connect_timeout 60s;
        proxy_send_timeout 300s;
        proxy_read_timeout 300s;

        error_page 502 503 504 = @fastapi_offline;
    }

    # ── Root (/) — mode-dependent ──
    # entrypoint.sh links /tmp/pc-root.conf to one of the deploy snippets
    # BEFORE nginx starts (same runtime-file pattern as /tmp/pc-token.map):
    #   nginx-root-code.conf — local sim: code-server proxy (+ legacy /code)
    #   nginx-root-404.conf  — Codespaces: / is not served
    include /tmp/pc-root.conf;

    location @fastapi_offline {
        default_type text/html;
        charset utf-8;
        add_header Cache-Control "no-store" always;
        # Subresources (CSS/JS/fetch) must FAIL, not receive this HTML with a
        # 200 — a stylesheet that "loads" as HTML fires no error event, so the
        # pages' boot-race reload guard never kicks in and the page stays
        # broken. Only document navigations get the spinner page.
        if ($http_accept !~* "text/html") { return 503; }
        return 200 '<!DOCTYPE html><html><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title>PhysiCar</title><style>html,body{margin:0;height:100%;overflow:hidden;background:#0d0d10;color:#888;font-family:system-ui,sans-serif}body{display:flex;align-items:center;justify-content:center}.spin{width:42px;height:42px;border:4px solid #2a2a33;border-top-color:#666;border-radius:50%;animation:s 1s linear infinite}@keyframes s{to{transform:rotate(360deg)}}</style></head><body><div class="spin"></div><script>(function(){var n=0,t=null;function arm(ms){t=setTimeout(chk,ms)}async function chk(){t=null;if(document.hidden)return;try{var r=await fetch("/health?t="+Date.now(),{cache:"no-store"});if(r.ok){location.reload();return}}catch(e){}n++;arm(n<15?2000:15000)}document.addEventListener("visibilitychange",function(){if(!document.hidden&&!t)chk()});arm(2000)})();</script></body></html>';
    }
}
